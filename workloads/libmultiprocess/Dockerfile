# syntax=docker/dockerfile:1
#
# libmultiprocess workload: the upstream unit-test binary (`mptest`, built on
# Cap'n Proto's kj-test framework) packaged as a bedrock driver so the fuzzer can
# run it across deterministic timelines and surface intermittent (flaky)
# failures. libmultiprocess is a threaded Cap'n Proto IPC library; its tests
# deliberately race connection setup/teardown against in-flight calls, which is
# exactly the kind of concurrency that varying the deterministic schedule can
# break.
#
# The test binary is built with LLVM `-fsanitize-coverage=trace-pc-guard` and
# linked against the libpcguard -> libfeedback shim (+ `-Wl,--build-id`), so it
# registers a per-edge coverage buffer ("cov-<build-id>") the lab reads back to
# steer the search. The shim runtime (libpcguard.c, libfeedback.c) is compiled
# WITHOUT the coverage flag, or its hooks would instrument and recurse into
# themselves. libvmcall.h / libfeedback.{h,c} / libpcguard.c are staged into this
# build context by build.sh from guest/ (the single source of truth, outside the
# context).
#
# Coverage requires clang (gcc doesn't implement trace-pc-guard).

# Pin the upstream commit so the image is reproducible.
ARG LIBMP_REF=8412fcdc659e1379f9b4dea896c26bc1c5f3afa8

FROM alpine:3.21 AS build
# build-base: gcc/g++/make/binutils/musl-dev (binutils' ld supports --build-id),
# and the default toolchain that builds the uninstrumented pass-1 mpgen.
# clang19: the trace-pc-guard instrumentor — libmultiprocess targets a recent
# clang for its C++20 (alpine 3.20's clang 17 is too old; 3.21 ships clang 19,
# providing both unversioned clang/clang++ and clang-19/clang++-19). capnproto +
# -dev: the runtime library, headers, the `capnp` tool, and the CapnProto::kj-test
# target the test binary links. alpine 3.21 ships Cap'n Proto 1.0.2, which
# libmultiprocess's CMake accepts.
RUN apk add --no-cache build-base clang19 cmake git capnproto capnproto-dev

WORKDIR /src
# Guest hypercall + coverage shim (staged by build.sh) and the ready helper.
COPY libvmcall.h libfeedback.h libfeedback.c libpcguard.c ready.c /src/

# bedrock-ready: issues the ready VMCALL so the lab can take the boot checkpoint.
# Static, no coverage.
RUN gcc -O2 -static -o /bedrock-ready ready.c

# Coverage runtime, built WITHOUT -fsanitize-coverage. -Wl,--build-id on the
# final link (below) is what lets libfeedback key the buffer on the build-id.
RUN clang-19 -O2 -I/src -c libpcguard.c -o /src/libpcguard.o \
 && clang-19 -O2 -I/src -c libfeedback.c -o /src/libfeedback.o

ARG LIBMP_REF
RUN git clone https://github.com/bitcoin-core/libmultiprocess /src/libmp \
 && git -C /src/libmp checkout "$LIBMP_REF"

# Pass 1 — build an UNINSTRUMENTED mpgen. mpgen is the Cap'n Proto proxy-code
# generator that runs *at build time*; if it were instrumented it would issue a
# coverage-registration VMCALL on the (non-guest) build host and crash. Build it
# once, plain, then feed it to the instrumented build via -DMPGEN_EXECUTABLE so
# the instrumented mpgen target is never run.
RUN cmake -S /src/libmp -B /src/b1 -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /src/b1 --target mpgen -j"$(nproc)"

# Pass 2 — build the instrumented test binary. No CMAKE_BUILD_TYPE (so NDEBUG is
# not defined and the tests' assert()s stay live); -O1 for speed. The shim
# objects + --build-id are injected into the executable link. mptest's foo.capnp
# proxy code is generated by the pass-1 mpgen; the library's proxy.capnp goes
# through the stock (uninstrumented) `capnp` tool — so no instrumented binary
# ever runs during the build.
#
# -fno-sanitize-link-runtime: with -fsanitize-coverage, clang otherwise tries to
# link compiler-rt's standalone sanitizer runtime (libclang_rt.ubsan_standalone),
# which alpine doesn't ship — and which we don't want anyway, since libpcguard.o
# *is* our trace-pc-guard runtime. It's a link-time flag, so it lives in the
# linker flags.
RUN cmake -S /src/libmp -B /src/b2 \
      -DCMAKE_C_COMPILER=clang-19 -DCMAKE_CXX_COMPILER=clang++-19 \
      -DBUILD_TESTING=ON \
      -DMPGEN_EXECUTABLE=/src/b1/mpgen \
      -DCMAKE_CXX_FLAGS="-O1 -fsanitize-coverage=trace-pc-guard" \
      -DCMAKE_EXE_LINKER_FLAGS="-fno-sanitize-link-runtime -Wl,--build-id /src/libpcguard.o /src/libfeedback.o" \
 && cmake --build /src/b2 --target mptest -j"$(nproc)"

# Locate the built binary (don't assume its path in the build tree) and strip it
# here, in the build stage — strip lives in build-base, not the minimal runtime
# image. Stripping keeps the allocated .note.gnu.build-id note and the
# trace-pc-guard guard table, so coverage keying and recording still work.
RUN cp "$(find /src/b2 -name mptest -type f | head -1)" /mptest \
 && strip /mptest

FROM alpine:3.21
# Runtime libraries for the dynamically-linked test binary (same alpine release,
# so the Cap'n Proto/kj shared libs match the build's).
RUN apk add --no-cache libstdc++ capnproto
COPY --from=build /bedrock-ready /usr/local/bin/bedrock-ready
# The instrumented test binary, installed as a singleton driver. `singleton_`
# marks it as a unit-test driver: on any timeline only one runs at a time and no
# other driver runs alongside it (see workloads/README.md).
COPY --from=build /mptest /opt/bedrock/drivers/singleton_mptest
# Overridden by compose; a sane default so the container idles if run directly.
ENTRYPOINT ["/bin/sh", "-c", "sleep infinity"]
